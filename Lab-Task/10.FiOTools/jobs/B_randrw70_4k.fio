# Case B - PostgreSQL read-mostly OLTP (random 70% read / 30% write, 4 KiB)
# Substituted at run time by scripts/run_all.sh:
#   QD (1|8|32), FIO_FILE, SIZE, RUNTIME, RAMP, ENGINE
[global]
ioengine=${ENGINE}
direct=1
size=${SIZE}
runtime=${RUNTIME}
time_based=1
ramp_time=${RAMP}
group_reporting=1
filename=${FIO_FILE}
numjobs=1
iodepth=${QD}
percentile_list=50:95:99:99.9

[caseB]
rw=randrw
bs=4k
rwmixread=70
