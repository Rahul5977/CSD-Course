# Case C - PostgreSQL update-heavy OLTP at native 8 KiB page size (random 30% read / 70% write)
# Substituted at run time by scripts/run_all.sh:
#   QD (1|8|32), FIO_FILE, SIZE, RUNTIME, RAMP, ENGINE
[global]
ioengine=${ENGINE}
direct=1
size=${SIZE}
runtime=${RUNTIME}
time_based=1
ramp_time=${RAMP}
group_reporting=1
filename=${FIO_FILE}
numjobs=1
iodepth=${QD}
percentile_list=50:95:99:99.9

[caseC]
rw=randrw
bs=8k
rwmixread=30
