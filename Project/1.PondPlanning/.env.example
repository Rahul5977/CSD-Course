# Copy to .env and adjust. Never commit .env — it is in .gitignore.
# Every variable is optional; the defaults in app/core/config.py match this file.

# -- application -------------------------------------------------------------
POND_ENV=local                 # local | ci | docker | production
POND_DEBUG=false
POND_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
POND_LOG_FORMAT=console        # console for a terminal, json in Docker

# -- postgres ----------------------------------------------------------------
POND_POSTGRES_HOST=localhost   # `postgres` when running inside compose
POND_POSTGRES_PORT=5432
POND_POSTGRES_USER=pond
POND_POSTGRES_PASSWORD=pond    # change for anything reachable from a network
POND_POSTGRES_DB=pond

# -- redis -------------------------------------------------------------------
POND_REDIS_HOST=localhost      # `redis` when running inside compose
POND_REDIS_PORT=6379

# -- wiring: adapter behind each port ----------------------------------------
POND_PERSISTENCE=postgres      # postgres | memory   (memory: tests, laptop without Docker)
POND_JOB_RUNNER=celery         # celery | inline     (inline: run the job in the request)
POND_OBJECT_STORE=minio        # minio | local
POND_LOCAL_STORE_DIR=data/cache/store

# -- minio (S3-compatible object store; TiTiler reads COGs from it) ----------
POND_MINIO_ENDPOINT=localhost:9000   # `minio:9000` inside compose
POND_MINIO_ACCESS_KEY=pond
POND_MINIO_SECRET_KEY=pondpond       # change for anything reachable from a network
POND_MINIO_BUCKET=pond
POND_MINIO_SECURE=false

# -- security (P6) -----------------------------------------------------------
POND_JWT_PRIVATE_KEY_PATH=            # PEM; empty = ephemeral dev key pair (warned at start-up)
POND_JWT_PUBLIC_KEY_PATH=
POND_USERS=officer:officer-demo:officer,planner:planner-demo:planner,viewer:viewer-demo:viewer
POND_MAX_QUEUE_DEPTH=20               # deeper queues answer 429 + Retry-After

# -- tiles: public prefix the browser uses to reach TiTiler ------------------
POND_TILES_PUBLIC_BASE=/tiles

# -- host port mappings used by infra/docker-compose.yml ----------------------
POND_API_PORT=8000
POND_WEB_PORT=3000
POND_MINIO_PORT=9000
POND_MINIO_CONSOLE_PORT=9001
POND_TITILER_PORT=8080
POND_PROMETHEUS_PORT=9090
POND_GRAFANA_PORT=3001
POND_GRAFANA_PASSWORD=admin

# -- analysis defaults (overridable per request; never hard-coded per map) ----
POND_MAX_UPLOAD_MB=64
POND_POUR_POINT_SNAP_RADIUS_M=150
POND_DEFAULT_DEM_FLOOR_M=10    # finest cell size when the upload names no source DEM
POND_STREAM_THRESHOLD_AREA_M2=50000   # 5 ha upstream = a channel (calibrated on satellite)
POND_SNAP_MIN_UPSTREAM_AREA_M2=20000  # snap only onto cells draining >= 2 ha
POND_SITING_RISE_M=2                  # nominal rise for impoundment scoring
POND_SITING_TOP_N=5
POND_RAINFALL_SOURCE=live             # live | recorded (tests/CI/offline demo)
POND_RAINFALL_YEARS=30                # length of record analysed
POND_RAINFALL_CACHE_TTL_S=86400       # stale-if-error cache of the daily series
POND_GEOCODE_ENABLED=true      # name the village via OSM Nominatim from the AOI centroid
POND_GEOCODE_TIMEOUT_S=10.0    # Nominatim timeout; raise on slow hosts where the job competes for CPU
