# Copy to .env and adjust. Never commit .env — it is in .gitignore.
# Every variable is optional; the defaults in app/core/config.py match this file.

# -- application -------------------------------------------------------------
POND_ENV=local                 # local | ci | docker | production
POND_DEBUG=false
POND_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
POND_LOG_FORMAT=console        # console for a terminal, json in Docker

# -- postgres ----------------------------------------------------------------
POND_POSTGRES_HOST=localhost   # `postgres` when running inside compose
POND_POSTGRES_PORT=5432
POND_POSTGRES_USER=pond
POND_POSTGRES_PASSWORD=pond    # change for anything reachable from a network
POND_POSTGRES_DB=pond

# -- redis -------------------------------------------------------------------
POND_REDIS_HOST=localhost      # `redis` when running inside compose
POND_REDIS_PORT=6379

# -- host port mappings used by infra/docker-compose.yml ----------------------
POND_API_PORT=8000

# -- analysis defaults (overridable per request; never hard-coded per map) ----
POND_MAX_UPLOAD_MB=64
POND_POUR_POINT_SNAP_RADIUS_M=150
