# No `# syntax=` pin: it forces a registry fetch of the frontend image on every
# build, which fails on networks that reset Docker Hub connections (seen on the
# campus network). The builtin BuildKit in Docker >= 23 covers everything used here.
#
# API image. Multi-stage so the runtime layer carries no build toolchain, and
# dependency installation is a separate cached layer from the source copy — an
# edit to app/ rebuilds in seconds rather than reinstalling the world.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /srv

# Dependency layer: invalidated only when the lockfile changes.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY app ./app
COPY migrations ./migrations
COPY alembic.ini README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


FROM python:3.12-slim AS runtime

# libpq for psycopg3, curl for the container healthcheck, libexpat1 because the
# rasterio/GDAL wheel links against it and python:*-slim does not ship it
# ("ImportError: libexpat.so.1" is the symptom).
RUN apt-get update \
    && apt-get install --no-install-recommends -y libpq5 curl libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Never run as root: it is a two-line change now and a finding in any review later.
RUN useradd --create-home --uid 10001 pond
WORKDIR /srv

COPY --from=builder --chown=pond:pond /srv /srv

ENV PATH="/srv/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER pond
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=5 \
    CMD curl --fail --silent http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
