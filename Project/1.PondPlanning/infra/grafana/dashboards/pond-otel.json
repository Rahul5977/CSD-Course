{
 "title": "Pond \u2014 OpenTelemetry",
 "uid": "pond-otel",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "type": "bargauge",
   "title": "Contour analysis: mean time per algorithm stage (from the stage spans)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 14,
    "h": 13
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(sum by (pond_stage) (pond_job_stage_duration_seconds_sum{pond_job_kind=\"contour_analysis\"}) / sum by (pond_stage) (pond_job_stage_duration_seconds_count{pond_job_kind=\"contour_analysis\"}))",
     "legendFormat": "{{pond_stage}}",
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 3,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3D9DD9"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3D9DD9",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "bargauge",
   "title": "Mean job duration by kind",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 10,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pond_job_kind) (pond_job_duration_seconds_sum) / sum by (pond_job_kind) (pond_job_duration_seconds_count)",
     "legendFormat": "{{pond_job_kind}}",
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3D9DD9"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3D9DD9",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Jobs run (by kind)",
   "gridPos": {
    "x": 14,
    "y": 6,
    "w": 10,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pond_job_kind) (pond_job_duration_seconds_count)",
     "legendFormat": "{{pond_job_kind}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#3D9DD9"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3D9DD9",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "HTTP p95 latency by route (FastAPI instrumentation)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "HTTP requests/s by route and status",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count[5m]))",
     "legendFormat": "{{http_route}} {{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Mean catchment area delineated",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pond_catchment_area_ha_sum) / sum(pond_catchment_area_ha_count)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "displayName": "ha",
     "color": {
      "mode": "fixed",
      "fixedColor": "#3D9DD9"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3D9DD9",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Mean pond gross storage designed",
   "gridPos": {
    "x": 6,
    "y": 21,
    "w": 6,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pond_design_storage_m3_sum) / sum(pond_design_storage_m3_count)",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "displayName": "m\u00b3",
     "color": {
      "mode": "fixed",
      "fixedColor": "#3D9DD9"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3D9DD9",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Jobs executing now",
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pond_job_kind) (pond_jobs_active)",
     "legendFormat": "{{pond_job_kind}}"
    }
   ]
  },
  {
   "type": "logs",
   "title": "Application logs over OTLP (Loki) \u2014 expand a line for its trace_id",
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service_namespace=\"pond-planner\"} != \"maintenance.\" != \"GET /metrics\" != \"GET /health\" != \"GET /ready\""
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  }
 ]
}